<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="30dp">

        <!-- Header -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Showroom Information 🏢"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visit us or get in touch with our showroom"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="20dp"/>


        <!-- Showroom Information Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_showroom_card">

            <!-- Showroom Name -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Motors"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>


            <!-- Location -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍  Pune, Maharashtra"
                android:textSize="15sp"
                android:textColor="#A9B6C8"
                android:layout_marginTop="18dp"/>


            <!-- Phone -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📞  +91 98765 43210"
                android:textSize="15sp"
                android:textColor="#A9B6C8"
                android:layout_marginTop="14dp"/>


            <!-- Email -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✉️  smartmotors@example.com"
                android:textSize="15sp"
                android:textColor="#A9B6C8"
                android:layout_marginTop="14dp"/>


            <!-- Divider -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#263A57"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="18dp"/>


            <!-- Opening Hours -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPENING HOURS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#7EA6FF"
                android:letterSpacing="0.08"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕐  Monday - Saturday"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="9:00 AM - 7:00 PM"
                android:textSize="14sp"
                android:textColor="#94A3B8"
                android:layout_marginStart="28dp"
                android:layout_marginTop="3dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sunday"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10:00 AM - 5:00 PM"
                android:textSize="14sp"
                android:textColor="#94A3B8"
                android:layout_marginStart="28dp"
                android:layout_marginTop="3dp"/>

        </LinearLayout>


        <!-- View Location -->

        <Button
            android:id="@+id/btnViewLocation"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="📍  VIEW LOCATION"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_showroom_button"
            android:layout_marginTop="20dp"
            android:padding="0dp"/>

    </LinearLayout>

</ScrollView>