<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMART MOTORS"
                    android:textColor="#4F8CFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin Dashboard"
                    android:textColor="#F6F8FC"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your Smart Motors showroom"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- OVERVIEW -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overview"
            android:textColor="#F6F8FC"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />


        <!-- STATISTICS -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- TOTAL CARS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="17dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_admin_stat">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#4F8CFF"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvTotalCars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:layout_marginTop="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total vehicles"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />

            </LinearLayout>


            <!-- AVAILABLE CARS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="17dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_admin_stat">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVAILABLE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#35B88A"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvAvailableCars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:layout_marginTop="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready to sell"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />

            </LinearLayout>


            <!-- ENQUIRIES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="17dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_admin_stat">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENQUIRIES"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#8B8CF8"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvTotalEnquiries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:layout_marginTop="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer requests"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />

            </LinearLayout>


            <!-- TEST DRIVES -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="122dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:padding="17dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_admin_stat">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEST DRIVES"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#E8A84E"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvTotalTestDrives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:layout_marginTop="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bookings"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </GridLayout>


        <!-- MANAGEMENT -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Management"
            android:textColor="#F6F8FC"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />


        <!-- MANAGE CARS -->

        <Button
            android:id="@+id/btnAdminCars"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Manage Cars"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_admin_cars_button"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            android:gravity="center_vertical"
            android:drawableLeft="@drawable/ic_car"
            android:drawablePadding="14dp"
            app:backgroundTint="@null"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />


        <!-- MANAGE ENQUIRIES -->

        <Button
            android:id="@+id/btnAdminEnquiries"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Manage Enquiries"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_admin_enquiries_button"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            android:gravity="center_vertical"
            android:drawableLeft="@drawable/ic_enquiry"
            android:drawablePadding="14dp"
            app:backgroundTint="@null"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginTop="10dp" />


        <!-- MANAGE TEST DRIVES -->

        <Button
            android:id="@+id/btnAdminTestDrives"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="Manage Test Drives"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_admin_test_drive_button"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            android:gravity="center_vertical"
            android:drawableLeft="@drawable/ic_calendar"
            android:drawablePadding="14dp"
            app:backgroundTint="@null"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginTop="10dp" />


        <!-- LOGOUT -->

        <Button
            android:id="@+id/btnAdminLogout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Logout"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_admin_logout_button"
            app:backgroundTint="@null"
            android:textAllCaps="false"
            android:gravity="center_vertical"
            android:drawableLeft="@drawable/ic_logout"
            android:drawablePadding="14dp"
            android:drawableTint="@null"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>