<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_car_card">

    <!-- Car Image -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:background="#101C2D"
        android:padding="6dp">

        <ImageView
            android:id="@+id/ivCarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Car Image"/>

    </FrameLayout>


    <!-- Car Information -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="13dp"
        android:paddingBottom="4dp">


        <!-- Car Name -->

        <TextView
            android:id="@+id/tvCarName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hyundai Creta"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>


        <!-- Price -->

        <TextView
            android:id="@+id/tvCarPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹12,50,000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#7EA6FF"
            android:layout_marginTop="4dp"/>


        <!-- Specifications -->

        <TextView
            android:id="@+id/tvCarInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Petrol • Automatic • 17 km/l"
            android:textSize="13sp"
            android:textColor="#A9B6C8"
            android:layout_marginTop="6dp"/>


        <!-- Availability -->

        <TextView
            android:id="@+id/tvAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#70D49B"
            android:background="@drawable/bg_available_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="9dp"/>


        <!-- View Details -->

        <Button
            android:id="@+id/btnViewDetails"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:text="VIEW DETAILS  →"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_blue_button"
            android:layout_marginTop="13dp"
            android:padding="0dp"
            android:minHeight="0dp"/>


        <!-- Compare -->

        <Button
            android:id="@+id/btnCompare"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:text="⚖  COMPARE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#9DBBFF"
            android:background="@drawable/bg_outline_button"
            android:layout_marginTop="8dp"
            android:padding="0dp"
            android:minHeight="0dp"/>

    </LinearLayout>

</LinearLayout>