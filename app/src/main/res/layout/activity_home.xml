<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="30dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMART MOTORS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#6EA0FF"
                    android:letterSpacing="0.12"/>

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome! 👋"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find your perfect car"
                    android:textSize="13sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>


            <!-- Profile -->

            <ImageButton
                android:id="@+id/btnProfile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/bg_profile_circle_dark"
                android:padding="12dp"
                android:contentDescription="Profile"
                android:scaleType="centerInside"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FEATURED CARS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Featured Cars"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp"/>


        <!-- Featured Cars Slider -->

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerFeaturedCars"
            android:layout_width="match_parent"
            android:layout_height="315dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:overScrollMode="never"/>


        <!-- Carousel Dots -->

        <LinearLayout
            android:id="@+id/layoutDots"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="5dp"/>


        <!-- ================================================= -->
        <!-- QUICK ACTIONS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"/>


        <!-- Quick Action Grid -->

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:layout_marginTop="8dp">

            <!-- Browse Cars -->

            <Button
                android:id="@+id/btnCars"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="Cars"
                android:drawableTop="@drawable/ic_car"
                android:drawablePadding="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_home_action"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:lineSpacingExtra="5dp"/>


            <!-- Favorites -->

            <Button
                android:id="@+id/btnFavorites"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="Favorites"
                android:drawableTop="@drawable/ic_favorite"
                android:drawablePadding="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_home_action"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:lineSpacingExtra="5dp"/>


            <!-- Enquiries -->

            <Button
                android:id="@+id/btnMyEnquiries"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="Enquiries"
                android:drawableTop="@drawable/ic_enquiry"
                android:drawablePadding="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_home_action"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:lineSpacingExtra="5dp"/>


            <!-- Test Drives -->

            <Button
                android:id="@+id/btnMyTestDrives"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="Test Drives"
                android:drawableTop="@drawable/ic_calendar"
                android:drawablePadding="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_home_action"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:lineSpacingExtra="5dp"/>


            <!-- Notifications -->

            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="Notifications"
                android:drawableTop="@drawable/ic_notifications"
                android:drawablePadding="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_home_action"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:lineSpacingExtra="5dp"/>


            <!-- Showroom -->

            <Button
                android:id="@+id/btnShowroom"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="Showroom"
                android:drawableTop="@drawable/ic_showroom"
                android:drawablePadding="8dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_home_action"
                app:backgroundTint="@null"
                android:textAllCaps="false"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="6dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:lineSpacingExtra="5dp"/>

        </GridLayout>


    </LinearLayout>

</ScrollView>