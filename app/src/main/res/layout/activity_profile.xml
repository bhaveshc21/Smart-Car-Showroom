<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- ============================= -->
        <!-- HEADER -->
        <!-- ============================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMART MOTORS"
                    android:textColor="#4F8CFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Profile"
                    android:textColor="#F6F8FC"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your account and preferences"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Profile Icon -->

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_profile"
                android:background="@drawable/bg_profile_circle_dark"
                android:padding="10dp"
                android:contentDescription="Profile" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- PERSONAL INFORMATION -->
        <!-- ============================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_profile_card"
            android:padding="20dp"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSONAL INFORMATION"
                android:textColor="#4F8CFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Name -->

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <!-- Divider -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#26344A"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp" />

            <!-- Email -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#C8D1DF"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Phone -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHONE"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone"
                    android:textColor="#C8D1DF"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ============================= -->
        <!-- ACCOUNT -->
        <!-- ============================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account"
            android:textColor="#F6F8FC"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />


        <!-- ============================= -->
        <!-- EDIT PROFILE -->
        <!-- ============================= -->

        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Edit Profile"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_profile_primary"
            android:drawableLeft="@drawable/ic_edit"
            android:drawablePadding="10dp"
            android:drawableTint="@null"
            android:gravity="center"
            android:textAllCaps="false"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@null" />


        <!-- ============================= -->
        <!-- MY ENQUIRIES -->
        <!-- ============================= -->

        <Button
            android:id="@+id/btnProfileEnquiries"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="My Enquiries"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_profile_button"
            android:drawableLeft="@drawable/ic_enquiry"
            android:drawablePadding="10dp"
            android:drawableTint="@null"
            android:gravity="center"
            android:textAllCaps="false"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@null"
            android:layout_marginTop="10dp" />


        <!-- ============================= -->
        <!-- MY TEST DRIVES -->
        <!-- ============================= -->

        <Button
            android:id="@+id/btnProfileTestDrives"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="My Test Drives"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_profile_button"
            android:drawableLeft="@drawable/ic_car"
            android:drawablePadding="10dp"
            android:drawableTint="@null"
            android:gravity="center"
            android:textAllCaps="false"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@null"
            android:layout_marginTop="10dp" />


        <!-- ============================= -->
        <!-- NOTIFICATIONS -->
        <!-- ============================= -->

        <Button
            android:id="@+id/btnProfileNotifications"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Notifications"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_profile_button"
            android:drawableLeft="@drawable/ic_notifications"
            android:drawablePadding="10dp"
            android:drawableTint="@null"
            android:gravity="center"
            android:textAllCaps="false"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@null"
            android:layout_marginTop="10dp" />


        <!-- ============================= -->
        <!-- LOGOUT -->
        <!-- ============================= -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Logout"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/bg_profile_logout"
            android:drawableLeft="@drawable/ic_logout"
            android:drawablePadding="10dp"
            android:drawableTint="@null"
            android:gravity="center"
            android:textAllCaps="false"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@null"
            android:layout_marginTop="24dp" />


        <!-- ============================= -->
        <!-- DELETE ACCOUNT -->
        <!-- ============================= -->

        <Button
            android:id="@+id/btnDeleteAccount"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Delete Account"
            android:textColor="#E56B6F"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_delete_account"
            android:drawableLeft="@drawable/ic_delete"
            android:drawablePadding="10dp"
            android:drawableTint="@null"
            android:gravity="center"
            android:textAllCaps="false"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@null"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>