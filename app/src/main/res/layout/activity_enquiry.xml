<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="30dp">

        <!-- Header -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send an Enquiry 📩"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Have a question? Send it to our showroom."
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="20dp"/>


        <!-- Selected Car -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_enquiry_car_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECTED CAR"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#7EA6FF"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/tvEnquiryCar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Car: Hyundai Creta"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- Enquiry Type -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enquiry Type"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"/>

        <Spinner
            android:id="@+id/spinnerEnquiryType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_enquiry_spinner"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"/>


        <!-- Message -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Message"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etEnquiryMessage"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:hint="Write your enquiry..."
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7F8EA3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="15dp"
            android:background="@drawable/bg_enquiry_message"/>


        <!-- Submit -->

        <Button
            android:id="@+id/btnSubmitEnquiry"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="SUBMIT ENQUIRY"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_enquiry_button"
            android:layout_marginTop="20dp"
            android:padding="0dp"/>

    </LinearLayout>

</ScrollView>