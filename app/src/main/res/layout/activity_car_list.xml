<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07111F"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp">

    <!-- Header -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explore Cars 🚗"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find the right car for you"
        android:textSize="13sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="14dp"/>


    <!-- Search -->

    <EditText
        android:id="@+id/etSearchCars"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Search cars or brands..."
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:textColorHint="#7F8EA3"
        android:singleLine="true"
        android:inputType="text"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_dark_search"/>


    <!-- Filter Row -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:layout_marginTop="11dp">

        <!-- Brand -->

        <Spinner
            android:id="@+id/spinnerBrand"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_spinner"
            android:paddingStart="7dp"
            android:paddingEnd="3dp"/>


        <!-- Fuel -->

        <Spinner
            android:id="@+id/spinnerFuel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_dark_spinner"
            android:paddingStart="7dp"
            android:paddingEnd="3dp"/>


        <!-- Transmission -->

        <Spinner
            android:id="@+id/spinnerTransmission"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_dark_spinner"
            android:paddingStart="7dp"
            android:paddingEnd="3dp"/>

    </LinearLayout>


    <!-- Car List -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCars"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingBottom="6dp"/>


    <!-- Compare Selected -->

    <Button
        android:id="@+id/btnCompareSelected"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="⚖  COMPARE SELECTED CARS"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_blue_button"
        android:layout_marginTop="8dp"
        android:padding="0dp"
        android:minHeight="0dp"/>

</LinearLayout>