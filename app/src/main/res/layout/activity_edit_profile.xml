<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="30dp">

        <!-- Header -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Profile ✏️"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update your personal information"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="25dp"/>


        <!-- Profile Form -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_edit_profile_card">

            <!-- Name -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAME"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#7EA6FF"
                android:letterSpacing="0.08"/>

            <EditText
                android:id="@+id/etEditName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Enter your name"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8EA3"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/bg_edit_profile_input"
                android:layout_marginTop="8dp"/>


            <!-- Email -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#7EA6FF"
                android:letterSpacing="0.08"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/etEditEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Enter your email"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8EA3"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/bg_edit_profile_input"
                android:layout_marginTop="8dp"/>


            <!-- Phone -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHONE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#7EA6FF"
                android:letterSpacing="0.08"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/etEditPhone"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Enter your phone number"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F8EA3"
                android:inputType="phone"
                android:singleLine="true"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:background="@drawable/bg_edit_profile_input"
                android:layout_marginTop="8dp"/>

        </LinearLayout>


        <!-- Save Button -->

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="SAVE PROFILE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_edit_profile_save"
            android:layout_marginTop="22dp"
            android:padding="0dp"/>

    </LinearLayout>

</ScrollView>