<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1E293B"
                android:endColor="#0F172A"
                android:angle="270"/>
